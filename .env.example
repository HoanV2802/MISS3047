# Server only. Copy to .env locally; add the same variables in Vercel.
APP_ORIGIN=http://localhost:4173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Legacy service_role JWT is also supported as SUPABASE_SERVICE_ROLE_KEY.
SESSION_ENCRYPTION_KEY=YOUR_RANDOM_32_BYTE_BASE64_KEY
PORT=4173
# Optional live tests: use a dedicated test project and separately supplied accounts.
TEST_MANAGER_PHONE=
TEST_MANAGER_PASSWORD=
TEST_EMPLOYEE_PHONE=
TEST_EMPLOYEE_PASSWORD=

# Live tests NEVER run without explicit authorization for a dedicated demo.
TWOCE_LIVE_AUTHORIZED=
TEST_EXPECTED_SUPABASE_URL=
TEST_API_ORIGIN=
# Optional write test creates a NEW unused week and deliberately leaves it intact.
TWOCE_LIVE_WRITE_AUTHORIZED=
TEST_WEEK=
